{
  "name": "@print-designer/designer",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:lib": "vue-tsc --noEmit && vite build -c vite.lib.config.ts",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist-lib/print-designer.es.js",
      "require": "./dist-lib/print-designer.umd.cjs"
    },
    "./style.css": "./dist-lib/hiprint-business-designer.css"
  },
  "files": ["dist-lib", "src", "README.md"],
  "peerDependencies": { "vue": "^3.5.0" },
  "dependencies": {
    "jquery": "^3.7.1",
    "@print-designer/vue-plugin-hiprint": "workspace:*"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5",
    "vue": "^3.5.18"
  }
}
